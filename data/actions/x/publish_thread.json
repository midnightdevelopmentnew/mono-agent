{
  "actionType": "publish_thread",
  "platform": "x",
  "version": "1.0.0",
  "description": "Publish a 2-3 part thread from the inline composer. Types each part into its own box via the composer's add-post button, then posts them together.",
  "metadata": { "requiresAuth": true, "supportsPagination": false, "supportsRetry": false },
  "inputs": { "required": ["part1"], "optional": ["part2", "part3"] },
  "outputs": { "success": [], "failure": ["error"] },
  "steps": [
    { "id": "navigate_to_home", "type": "navigate", "url": "https://x.com/home", "timeout": 30 },
    { "id": "find_box0", "type": "find_element", "xpath": "//div[@contenteditable='true' and @data-testid='tweetTextarea_0'] | //div[@role='textbox']", "timeout": 15 },
    { "id": "clear_composer", "type": "eval", "text": "(function(){var e=document.querySelector('[data-testid=\"tweetTextarea_0\"]');if(e){e.focus();document.execCommand('selectAll',false,null);document.execCommand('delete',false,null);}return 'cleared'})()" },
    { "id": "after_clear", "type": "wait", "duration": 1.0, "waitFor": "time" },
    { "id": "type_part1", "type": "type", "elementRef": "find_box0", "text": "{{part1}}", "humanLike": true },

    { "id": "check_part2", "type": "condition", "condition": "part2.length > 0", "then": ["find_add2", "click_add2", "wait_box1", "find_box1", "type_part2"], "else": [] },
    { "id": "find_add2", "type": "find_element", "xpath": "//*[@data-testid='addButton']", "timeout": 10 },
    { "id": "click_add2", "type": "click", "elementRef": "find_add2" },
    { "id": "wait_box1", "type": "wait", "duration": 2.0, "waitFor": "time" },
    { "id": "find_box1", "type": "find_element", "xpath": "//div[@contenteditable='true' and @data-testid='tweetTextarea_1']", "timeout": 10 },
    { "id": "type_part2", "type": "type", "elementRef": "find_box1", "text": "{{part2}}", "humanLike": true },

    { "id": "check_part3", "type": "condition", "condition": "part3.length > 0", "then": ["find_add3", "click_add3", "wait_box2", "find_box2", "type_part3"], "else": [] },
    { "id": "find_add3", "type": "find_element", "xpath": "//*[@data-testid='addButton']", "timeout": 10 },
    { "id": "click_add3", "type": "click", "elementRef": "find_add3" },
    { "id": "wait_box2", "type": "wait", "duration": 2.0, "waitFor": "time" },
    { "id": "find_box2", "type": "find_element", "xpath": "//div[@contenteditable='true' and @data-testid='tweetTextarea_2']", "timeout": 10 },
    { "id": "type_part3", "type": "type", "elementRef": "find_box2", "text": "{{part3}}", "humanLike": true },

    { "id": "settle", "type": "wait", "duration": 2.0, "waitFor": "time" },
    { "id": "find_post_button", "type": "find_element", "xpath": "//button[@data-testid='tweetButtonInline'] | //div[@role='button'][@data-testid='tweetButtonInline'] | //button[.//span[text()='Post all']] | //div[@role='button'][.//span[text()='Post all']]", "timeout": 15 },
    { "id": "click_post", "type": "click", "elementRef": "find_post_button", "waitFor": "tweet_posted" }
  ],
  "errorHandling": { "onFinalFailure": "abort" }
}
