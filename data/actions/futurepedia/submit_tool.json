{
  "actionType": "submit_tool",
  "platform": "FUTUREPEDIA",
  "version": "1.0.0",
  "description": "Submit an AI tool to the Futurepedia directory, including name, URL, description, category, and pricing",
  "metadata": { "requiresAuth": true, "supportsPagination": false, "supportsRetry": true },
  "inputs": {
    "required": ["name", "url", "description", "category", "pricing"],
    "optional": ["logoPath", "tagline", "tags"]
  },
  "outputs": {
    "success": ["success", "toolUrl"],
    "failure": ["error"]
  },
  "steps": [
    {
      "id": "navigate_to_submit",
      "type": "navigate",
      "url": "https://www.futurepedia.io/submit-tool",
      "waitFor": "page_load",
      "timeout": 30,
      "onError": { "action": "retry", "maxRetries": 3, "onFailure": "mark_failed" }
    },
    {
      "id": "find_name_input",
      "type": "find_element",
      "xpath": "//input[@id='name' or @name='name']",
      "alternatives": [
        "//label[contains(text(),'Tool Name') or contains(text(),'Name')]/following::input[1]"
      ],
      "timeout": 15,
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "type_name",
      "type": "type",
      "elementRef": "find_name_input",
      "text": "{{name}}",
      "humanLike": true
    },
    {
      "id": "find_url_input",
      "type": "find_element",
      "xpath": "//input[@id='url' or @name='url' or @type='url']",
      "alternatives": [
        "//label[contains(text(),'Website') or contains(text(),'URL')]/following::input[1]"
      ],
      "timeout": 10,
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "type_url",
      "type": "type",
      "elementRef": "find_url_input",
      "text": "{{url}}",
      "humanLike": true
    },
    {
      "id": "check_has_tagline",
      "type": "condition",
      "condition": "tagline != '' and tagline != None",
      "then": ["find_tagline_input", "type_tagline"],
      "else": []
    },
    {
      "id": "find_tagline_input",
      "type": "find_element",
      "xpath": "//input[@id='tagline' or @name='tagline']",
      "timeout": 10,
      "onError": { "action": "skip" }
    },
    {
      "id": "type_tagline",
      "type": "type",
      "elementRef": "find_tagline_input",
      "text": "{{tagline}}",
      "humanLike": true
    },
    {
      "id": "find_description_textarea",
      "type": "find_element",
      "xpath": "//textarea[@id='description' or @name='description']",
      "alternatives": [
        "//label[contains(text(),'Description')]/following::textarea[1]"
      ],
      "timeout": 10,
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "type_description",
      "type": "type",
      "elementRef": "find_description_textarea",
      "text": "{{description}}",
      "humanLike": true
    },
    {
      "id": "find_category_select",
      "type": "find_element",
      "xpath": "//select[@id='category' or @name='category']",
      "alternatives": [
        "//label[contains(text(),'Category')]/following::select[1]",
        "//button[@id='category-dropdown']"
      ],
      "timeout": 10,
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "click_category_select",
      "type": "click",
      "elementRef": "find_category_select",
      "waitFor": "element_visible"
    },
    {
      "id": "find_category_option",
      "type": "find_element",
      "xpath": "//select[@id='category' or @name='category']//option[normalize-space(text())='{{category}}']",
      "alternatives": [
        "//div[@role='listbox']//div[@role='option' and normalize-space(text())='{{category}}']"
      ],
      "timeout": 5,
      "onError": { "action": "skip" }
    },
    {
      "id": "click_category_option",
      "type": "click",
      "elementRef": "find_category_option",
      "onError": { "action": "skip" }
    },
    {
      "id": "find_pricing_select",
      "type": "find_element",
      "xpath": "//select[@id='pricing' or @name='pricing']",
      "alternatives": [
        "//label[contains(text(),'Pricing')]/following::select[1]",
        "//button[@id='pricing-dropdown']"
      ],
      "timeout": 10,
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "click_pricing_select",
      "type": "click",
      "elementRef": "find_pricing_select",
      "waitFor": "element_visible"
    },
    {
      "id": "find_pricing_option",
      "type": "find_element",
      "xpath": "//select[@id='pricing' or @name='pricing']//option[normalize-space(text())='{{pricing}}']",
      "alternatives": [
        "//div[@role='listbox']//div[@role='option' and normalize-space(text())='{{pricing}}']"
      ],
      "timeout": 5,
      "onError": { "action": "skip" }
    },
    {
      "id": "click_pricing_option",
      "type": "click",
      "elementRef": "find_pricing_option",
      "onError": { "action": "skip" }
    },
    {
      "id": "check_has_tags",
      "type": "condition",
      "condition": "tags != '' and tags != None",
      "then": ["find_tags_input", "type_tags"],
      "else": []
    },
    {
      "id": "find_tags_input",
      "type": "find_element",
      "xpath": "//input[@id='tags' or @name='tags']",
      "timeout": 10,
      "onError": { "action": "skip" }
    },
    {
      "id": "type_tags",
      "type": "type",
      "elementRef": "find_tags_input",
      "text": "{{tags}}",
      "humanLike": true
    },
    {
      "id": "check_has_logo",
      "type": "condition",
      "condition": "logoPath != '' and logoPath != None",
      "then": ["find_logo_input", "upload_logo"],
      "else": []
    },
    {
      "id": "find_logo_input",
      "type": "find_element",
      "xpath": "//input[@type='file' and (@id='logo' or @name='logo')]",
      "timeout": 10,
      "onError": { "action": "skip" }
    },
    {
      "id": "upload_logo",
      "type": "type",
      "elementRef": "find_logo_input",
      "text": "{{logoPath}}",
      "onError": { "action": "skip" }
    },
    {
      "id": "find_submit_button",
      "type": "find_element",
      "xpath": "//button[@type='submit' and (contains(text(),'Submit') or contains(text(),'Add Tool'))]",
      "alternatives": [
        "//button[@data-testid='submit-tool-button']"
      ],
      "timeout": 10,
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "click_submit",
      "type": "click",
      "elementRef": "find_submit_button",
      "waitFor": "network_idle",
      "onSuccess": { "action": "update_progress", "set": { "success": true } },
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "wait_after_submit",
      "type": "wait",
      "duration": 3,
      "waitFor": "time"
    },
    {
      "id": "extract_tool_url",
      "type": "extract_attribute",
      "xpath": "//link[@rel='canonical']",
      "attribute": "href",
      "variable_name": "toolUrl",
      "timeout": 10,
      "onError": { "action": "skip" }
    },
    {
      "id": "log_success",
      "type": "log",
      "description": "Tool submitted to Futurepedia",
      "value": "Name: {{name}} URL: {{url}}"
    }
  ],
  "loops": [],
  "errorHandling": { "globalRetries": 2, "retryDelay": 3000, "onFinalFailure": "log_and_continue" }
}
