{
  "actionType": "find_by_keyword",
  "platform": "THREADS",
  "version": "1.0.0",
  "description": "Search for Threads posts and users using keywords",
  "metadata": {
    "requiresAuth": true,
    "supportsPagination": true,
    "supportsRetry": true
  },
  "inputs": {
    "required": [
      "keyword",
      "maxResultsCount"
    ],
    "optional": []
  },
  "outputs": {
    "success": [
      "resultsCount",
      "maxResultsCount"
    ],
    "failure": []
  },
  "steps": [
    {
      "id": "build_search_url",
      "type": "update_progress",
      "set": {
        "searchUrl": "https://www.threads.net/search?q={{keyword}}&serp_type=default"
      }
    },
    {
      "id": "navigate_to_search",
      "type": "navigate",
      "url": "{{searchUrl}}",
      "waitFor": "page_load",
      "timeout": 30,
      "onError": {
        "action": "retry",
        "maxRetries": 3
      }
    },
    {
      "id": "wait_for_results",
      "type": "wait",
      "duration": 3.0,
      "waitFor": "time"
    },
    {
      "id": "find_posts",
      "type": "find_element",
      "xpath": "//div[@data-pressable-container='true'][.//time]",
      "timeout": 15
    },
    {
      "id": "extract_post_data",
      "type": "extract_multiple",
      "configKey": "posts",
      "onSuccess": {
        "action": "save_data"
      }
    },
    {
      "id": "check_more_needed",
      "type": "condition",
      "condition": "resultsCount < maxResultsCount",
      "then": [
        "scroll_for_more",
        "extract_post_data",
        "check_more_needed"
      ],
      "else": []
    },
    {
      "id": "scroll_for_more",
      "type": "scroll",
      "elementRef": "find_posts",
      "waitFor": "time"
    }
  ],
  "errorHandling": {
    "globalRetries": 3,
    "retryDelay": 2000,
    "onFinalFailure": "log_and_continue"
  }
}
