{
  "actionType": "upvote_post",
  "platform": "TILDES",
  "version": "1.0.0",
  "description": "Vote on a Tildes topic",
  "metadata": { "requiresAuth": true, "supportsPagination": false, "supportsRetry": true },
  "inputs": {
    "required": ["topicUrl"],
    "optional": ["skipIfAlreadyVoted"]
  },
  "outputs": {
    "success": ["success", "voteCount"],
    "failure": ["error"]
  },
  "steps": [
    {
      "id": "navigate_to_topic",
      "type": "navigate",
      "url": "{{topicUrl}}",
      "waitFor": "page_load",
      "timeout": 30,
      "onError": { "action": "retry", "maxRetries": 3, "onFailure": "mark_failed" }
    },
    {
      "id": "find_vote_button",
      "type": "find_element",
      "xpath": "//form[contains(@class,'topic-voting-form')]//button[@type='submit']",
      "alternatives": [
        "//button[contains(@class,'topic-voting-button')]",
        "//button[@aria-label='Vote on this topic']",
        "//div[contains(@class,'topic-voting')]//button"
      ],
      "timeout": 15,
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "check_already_voted",
      "type": "condition",
      "condition": {
        "variable": "skipIfAlreadyVoted",
        "operator": "equals",
        "value": true
      },
      "then": ["check_vote_state"]
    },
    {
      "id": "check_vote_state",
      "type": "extract_attribute",
      "elementRef": "find_vote_button",
      "attribute": "class",
      "variable_name": "voteButtonClass",
      "timeout": 5,
      "onError": { "action": "skip" }
    },
    {
      "id": "click_vote",
      "type": "click",
      "elementRef": "find_vote_button",
      "waitFor": "network_idle",
      "onSuccess": { "action": "update_progress", "set": { "success": true } },
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "wait_after_vote",
      "type": "wait",
      "duration": 2,
      "waitFor": "time"
    },
    {
      "id": "extract_vote_count",
      "type": "extract_text",
      "xpath": "//span[contains(@class,'topic-voting-votes')]",
      "variable_name": "voteCount",
      "timeout": 10,
      "onError": { "action": "skip" }
    },
    {
      "id": "log_success",
      "type": "log",
      "description": "Voted on Tildes topic",
      "value": "Topic: {{topicUrl}}"
    }
  ],
  "loops": [],
  "errorHandling": { "globalRetries": 2, "retryDelay": 2000, "onFinalFailure": "log_and_continue" }
}
