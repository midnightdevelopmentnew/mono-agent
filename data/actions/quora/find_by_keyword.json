{
  "actionType": "find_by_keyword",
  "platform": "QUORA",
  "version": "1.0.0",
  "description": "Search for questions on Quora by keyword",
  "metadata": { "requiresAuth": false, "supportsPagination": true, "supportsRetry": true },
  "inputs": {
    "required": ["keyword", "maxResultsCount"],
    "optional": []
  },
  "outputs": {
    "success": ["resultsCount", "maxResultsCount"],
    "failure": []
  },
  "steps": [
    {
      "id": "build_search_url",
      "type": "update_progress",
      "set": {
        "searchUrl": "https://www.quora.com/search?q={{keyword}}&type=question"
      }
    },
    {
      "id": "navigate_to_search",
      "type": "navigate",
      "url": "{{searchUrl}}",
      "waitFor": "page_load",
      "timeout": 30,
      "onError": { "action": "retry", "maxRetries": 3 }
    },
    {
      "id": "wait_for_results",
      "type": "wait",
      "duration": 3,
      "waitFor": "time"
    },
    {
      "id": "find_question_results",
      "type": "find_element",
      "xpath": "//div[@data-testid='searchResult']//a[@role='link']",
      "alternatives": [
        "//span[contains(@class, 'q-text')]/ancestor::a[1]",
        "//a[@class='q-click-wrapper']"
      ],
      "timeout": 15,
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "extract_question_urls",
      "type": "extract_multiple",
      "xpath": "//div[@data-testid='searchResult']//a[@role='link']",
      "attribute": "href",
      "timeout": 10,
      "alternatives": [
        "//span[contains(@class, 'q-text')]/ancestor::a[1]"
      ]
    },
    {
      "id": "store_question_urls",
      "type": "update_progress",
      "set": {
        "questionUrls": "{{extract_question_urls.data}}",
        "resultsCount": "{{extract_question_urls.count}}"
      }
    },
    {
      "id": "check_more_needed",
      "type": "condition",
      "condition": "resultsCount < maxResultsCount",
      "then": ["scroll_for_more", "extract_question_urls", "store_question_urls", "check_more_needed"],
      "else": []
    },
    {
      "id": "scroll_for_more",
      "type": "scroll",
      "elementRef": "find_question_results",
      "waitFor": "time"
    }
  ],
  "errorHandling": { "globalRetries": 3, "retryDelay": 2000, "onFinalFailure": "log_and_continue" }
}
