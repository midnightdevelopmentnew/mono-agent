{
  "actionType": "comment_on_answer",
  "platform": "QUORA",
  "version": "1.0.0",
  "description": "Post a comment on a Quora answer",
  "metadata": { "requiresAuth": true, "supportsPagination": false, "supportsRetry": false },
  "inputs": {
    "required": ["answerUrl", "commentText"],
    "optional": []
  },
  "outputs": {
    "success": ["commentPosted", "answerUrl"],
    "failure": ["error"]
  },
  "steps": [
    {
      "id": "navigate_to_answer",
      "type": "navigate",
      "url": "{{answerUrl}}",
      "waitFor": "page_load",
      "timeout": 30,
      "onError": { "action": "retry", "maxRetries": 3, "onFailure": "mark_failed" }
    },
    {
      "id": "wait_for_answer_load",
      "type": "wait",
      "duration": 2,
      "waitFor": "time"
    },
    {
      "id": "find_comment_trigger",
      "type": "find_element",
      "xpath": "//div[@role='button'][.//span[text()='Comment']]",
      "alternatives": [
        "//a[contains(., 'Add comment')]",
        "//span[text()='Comment']/ancestor::div[@role='button'][1]"
      ],
      "timeout": 15,
      "onError": { "action": "retry", "maxRetries": 2, "onFailure": "mark_failed" }
    },
    {
      "id": "click_comment_trigger",
      "type": "click",
      "elementRef": "find_comment_trigger",
      "onError": { "action": "retry", "maxRetries": 2, "onFailure": "mark_failed" }
    },
    {
      "id": "wait_for_comment_box",
      "type": "wait",
      "duration": 1.5,
      "waitFor": "time"
    },
    {
      "id": "find_comment_input",
      "type": "find_element",
      "xpath": "//div[@contenteditable='true'][@aria-label='Add a comment...']",
      "alternatives": [
        "//textarea[contains(@placeholder, 'Add a comment')]",
        "//div[@contenteditable='true'][contains(@class, 'comment')]"
      ],
      "timeout": 10,
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "type_comment",
      "type": "type",
      "elementRef": "find_comment_input",
      "text": "{{commentText}}",
      "humanLike": true,
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "find_submit_comment_button",
      "type": "find_element",
      "xpath": "//div[@role='button'][text()='Comment']",
      "alternatives": [
        "//button[contains(., 'Comment')]"
      ],
      "timeout": 10,
      "onError": { "action": "mark_failed" }
    },
    {
      "id": "click_submit_comment",
      "type": "click",
      "elementRef": "find_submit_comment_button",
      "waitFor": "network_idle",
      "onSuccess": { "action": "update_progress" },
      "onError": { "action": "mark_failed" }
    }
  ],
  "errorHandling": { "globalRetries": 3, "retryDelay": 2000, "onFinalFailure": "log_and_continue" }
}
