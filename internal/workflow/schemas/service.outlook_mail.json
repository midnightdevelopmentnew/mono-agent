{
  "credential_platform": "outlook",
  "fields": [
    { "key": "credential_id", "label": "Outlook Account", "type": "credential_picker", "required": true },
    { "key": "operation", "label": "Operation", "type": "select", "required": true, "options": ["list_messages", "get_message", "send_message", "create_draft", "send_draft", "delete_message", "whoami"], "default": "list_messages" },
    { "key": "mailbox", "label": "Mailbox", "type": "text", "required": false, "default": "inbox", "help": "Any Outlook well-known folder name: inbox, drafts, sentitems, deleteditems, junkemail, archive, outbox.", "depends_on": { "key": "operation", "values": ["list_messages"] } },
    { "key": "search", "label": "Search", "type": "text", "required": false, "help": "Full-text search, e.g. \"invoice\" or field-scoped like \"from:someone@x.com\". Takes priority over Unread Only / From Address below.", "depends_on": { "key": "operation", "values": ["list_messages"] } },
    { "key": "from_address", "label": "From Address", "type": "text", "required": false, "help": "Only messages sent from this exact address. Ignored if Search is set.", "depends_on": { "key": "operation", "values": ["list_messages"] } },
    { "key": "unread_only", "label": "Unread Only", "type": "boolean", "required": false, "default": false, "depends_on": { "key": "operation", "values": ["list_messages"] } },
    { "key": "max_results", "label": "Max Results", "type": "number", "required": false, "default": 10, "depends_on": { "key": "operation", "values": ["list_messages"] } },
    { "key": "message_id", "label": "Message ID", "type": "text", "required": false, "depends_on": { "key": "operation", "values": ["get_message", "send_draft", "delete_message"] } },
    { "key": "to", "label": "To", "type": "text", "required": false, "depends_on": { "key": "operation", "values": ["send_message", "create_draft"] } },
    { "key": "subject", "label": "Subject", "type": "text", "required": false, "depends_on": { "key": "operation", "values": ["send_message", "create_draft"] } },
    { "key": "body", "label": "Body", "type": "textarea", "required": false, "rows": 5, "depends_on": { "key": "operation", "values": ["send_message", "create_draft"] } },
    { "key": "body_type", "label": "Body Type", "type": "select", "required": false, "options": ["text", "html"], "default": "text", "depends_on": { "key": "operation", "values": ["send_message", "create_draft"] } }
  ]
}
